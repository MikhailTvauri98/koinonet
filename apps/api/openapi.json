{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Database and Redis are available.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "database": {
                                            "type": "boolean"
                                        },
                                        "redis": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database",
                                        "redis"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Database or Redis is unavailable.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "degraded"
                                        },
                                        "database": {
                                            "type": "boolean"
                                        },
                                        "redis": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database",
                                        "redis"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "operationId": "auth.login",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "phone": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "email": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "phone",
                                                "email"
                                            ]
                                        },
                                        "person": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "last_name": {
                                                    "type": "string"
                                                },
                                                "first_name": {
                                                    "type": "string"
                                                },
                                                "patronymic": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "status": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "last_name",
                                                "first_name",
                                                "patronymic",
                                                "status"
                                            ]
                                        },
                                        "permissions": {
                                            "type": "object",
                                            "properties": {
                                                "administrator": {
                                                    "type": "boolean"
                                                },
                                                "global": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "ministries": {
                                                    "type": "object",
                                                    "additionalProperties": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        }
                                                    }
                                                }
                                            },
                                            "required": [
                                                "administrator",
                                                "global",
                                                "ministries"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "person",
                                        "permissions"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "operationId": "auth.me",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "`MeResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "phone": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "email": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "phone",
                                                "email"
                                            ]
                                        },
                                        "person": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "last_name": {
                                                    "type": "string"
                                                },
                                                "first_name": {
                                                    "type": "string"
                                                },
                                                "patronymic": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "status": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "last_name",
                                                "first_name",
                                                "patronymic",
                                                "status"
                                            ]
                                        },
                                        "permissions": {
                                            "type": "object",
                                            "properties": {
                                                "administrator": {
                                                    "type": "boolean"
                                                },
                                                "global": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "ministries": {
                                                    "type": "object",
                                                    "additionalProperties": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        }
                                                    }
                                                }
                                            },
                                            "required": [
                                                "administrator",
                                                "global",
                                                "ministries"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "person",
                                        "permissions"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/permissions": {
            "get": {
                "operationId": "access.permissionCatalog",
                "tags": [
                    "PermissionCatalog"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `PermissionResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PermissionResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "login": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "remember": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "login",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "MeResource": {
                "type": "object",
                "properties": {
                    "user": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "phone": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "email": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "id",
                            "phone",
                            "email"
                        ]
                    },
                    "person": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "last_name": {
                                "type": "string"
                            },
                            "first_name": {
                                "type": "string"
                            },
                            "patronymic": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "status": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "last_name",
                            "first_name",
                            "patronymic",
                            "status"
                        ]
                    },
                    "permissions": {
                        "$ref": "#/components/schemas/UserPermissionsResource"
                    }
                },
                "required": [
                    "user",
                    "person",
                    "permissions"
                ],
                "title": "MeResource"
            },
            "PermissionResource": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "scope": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string",
                        "enum": [
                            "\u0412\u0438\u0434\u0435\u0442\u044c \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a",
                            "\u0412\u0438\u0434\u0435\u0442\u044c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b",
                            "\u0412\u0438\u0434\u0435\u0442\u044c \u0437\u0430\u043c\u0435\u0442\u043a\u0438",
                            "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u043b\u044e\u0434\u044c\u043c\u0438",
                            "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0442\u044c",
                            "\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f",
                            "\u0412\u0438\u0434\u0435\u0442\u044c \u0432\u0441\u0435 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f",
                            "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0432\u0441\u0435\u043c\u0438 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f\u043c\u0438",
                            "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0440\u043e\u043b\u044f\u043c\u0438",
                            "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0446\u0435\u0440\u043a\u0432\u0438",
                            "\u0416\u0443\u0440\u043d\u0430\u043b \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439",
                            "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u043e\u0441\u0442\u0430\u0432\u043e\u043c",
                            "\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u044b \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432",
                            "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0440\u043e\u043b\u044f\u043c\u0438 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f",
                            "\u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0435"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "enum": [
                            "\u0421\u043f\u0438\u0441\u043e\u043a \u043b\u044e\u0434\u0435\u0439 \u0438 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430: \u0424\u0418\u041e, \u0444\u043e\u0442\u043e, \u0441\u0442\u0430\u0442\u0443\u0441, \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f.",
                            "\u0422\u0435\u043b\u0435\u0444\u043e\u043d, \u043f\u043e\u0447\u0442\u0430 \u0438 \u0434\u0430\u0442\u0430 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.",
                            "\u0417\u0430\u043c\u0435\u0442\u043a\u0438 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430 \u043e \u043b\u044e\u0434\u044f\u0445.",
                            "\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c, \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438 \u0430\u0440\u0445\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043b\u044e\u0434\u0435\u0439, \u043c\u0435\u043d\u044f\u0442\u044c \u0424\u0418\u041e \u0438 \u0441\u0442\u0430\u0442\u0443\u0441, \u0441\u0442\u0438\u0440\u0430\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435.",
                            "\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f \u0438 \u0441\u0441\u044b\u043b\u043a\u0438 \u0441\u0431\u0440\u043e\u0441\u0430 \u043f\u0430\u0440\u043e\u043b\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u044b.",
                            "\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438 \u0430\u0440\u0445\u0438\u0432\u0430\u0446\u0438\u044f \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0439.",
                            "\u0421\u043e\u0441\u0442\u0430\u0432, \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0438 \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f \u0431\u0435\u0437 \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u043d\u0451\u043c.",
                            "\u0412\u0441\u0435 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u043f\u0440\u0430\u0432\u0430 \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0438.",
                            "\u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u043e\u043b\u0435\u0439 \u0438 \u0432\u044b\u0434\u0430\u0447\u0430 \u0438\u0445 \u043b\u044e\u0434\u044f\u043c.",
                            "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0446\u0435\u0440\u043a\u0432\u0438, \u0447\u0430\u0441\u043e\u0432\u043e\u0439 \u043f\u043e\u044f\u0441, \u0440\u0435\u0433\u0438\u043e\u043d \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u0432.",
                            "\u0425\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.",
                            "\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432, \u0432\u044b\u0434\u0430\u0432\u0430\u0442\u044c \u0438 \u0441\u043d\u0438\u043c\u0430\u0442\u044c \u0440\u043e\u043b\u0438 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f.",
                            "\u0422\u0435\u043b\u0435\u0444\u043e\u043d, \u043f\u043e\u0447\u0442\u0430 \u0438 \u0434\u0430\u0442\u0430 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u044d\u0442\u043e\u0433\u043e \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f.",
                            "\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c, \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438 \u0443\u0434\u0430\u043b\u044f\u0442\u044c \u0440\u043e\u043b\u0438 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f, \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u0440\u043e\u043b\u044c \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e.",
                            "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435, \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0438 \u043e\u0431\u043b\u043e\u0436\u043a\u0430 \u0441\u043b\u0443\u0436\u0435\u043d\u0438\u044f."
                        ]
                    }
                },
                "required": [
                    "key",
                    "scope",
                    "label",
                    "description"
                ],
                "title": "PermissionResource"
            },
            "UserPermissionsResource": {
                "type": "object",
                "properties": {
                    "administrator": {
                        "type": "boolean"
                    },
                    "global": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "ministries": {
                        "type": "object"
                    }
                },
                "required": [
                    "administrator",
                    "global",
                    "ministries"
                ],
                "title": "UserPermissionsResource"
            }
        },
        "responses": {
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}