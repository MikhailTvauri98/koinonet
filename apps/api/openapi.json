{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Database and Redis are available.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "database": {
                                            "type": "boolean"
                                        },
                                        "redis": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database",
                                        "redis"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Database or Redis is unavailable.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "degraded"
                                        },
                                        "database": {
                                            "type": "boolean"
                                        },
                                        "redis": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database",
                                        "redis"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}